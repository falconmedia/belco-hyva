<?xml version="1.0"?>
<!-- Allow guest and customer access to Belco config endpoint -->
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:App/etc/acl.xsd">
    <acl>
        <resources>
            <resource id="Magento_Customer::all">
                <resource id="Belco_Hyva::config" title="Belco Config"/>
            </resource>
        </resources>
    </acl>
</config>
