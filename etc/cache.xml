<?xml version="1.0"?>
<!-- Exclude Belco config endpoint from FPC and Varnish -->
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:App/etc/cache_types.xsd">
    <type name="full_page">
        <excludes>
            <exclude path="/belco/config" />
        </excludes>
    </type>
</config>
